# SWE-Agent Pro Configuration
PORT=3000
NODE_ENV=development

# Agent Tuning & Sandboxing
MAX_REPAIR_RETRIES=3
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_TIMEOUT_SEC=8.0
MODEL_PROVIDER=hybrid # Options: "hybrid", "deterministic_ast", "gemini"

# GEMINI_API_KEY: Optional LLM API key for advanced semantic reasoning
# AI Studio automatically injects this at runtime from user secrets if configured.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
